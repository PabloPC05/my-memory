{
  "name": "my-memory",
  "version": "0.1.0",
  "description": "Self-hosted, git-backed memory server for AI agents over MCP",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "my-memory": "bin/my-memory.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
