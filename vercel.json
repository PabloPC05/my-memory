{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && mkdir -p public && printf \"User-agent: *\\nDisallow: /\\n\" > public/robots.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/ingest",
      "schedule": "0 6 * * *"
    }
  ]
}
